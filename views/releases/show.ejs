<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= release.title %></title>
    <link rel="stylesheet" href="/styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <%- include('../partials/header') %>
    <main>
      <article class="release-detail">
        <% if (release.cover_url) { %>
        <img
          class="release-cover"
          src="<%= release.cover_url %>"
          alt="Cover of <%= release.title %>"
        />
        <% } else { %>
        <img
          class="release-cover"
          src="/images/no-cover.webp"
          alt="No cover available"
        />
        <% } %>

        <h1 class="release-title"><%= release.title %></h1>
        <p class="release-artist"><%= release.artist %></p>
        <p class="release-genre">
          <a href="/genres/<%= release.genre_id %>"
            ><%= release.genre_name %></a
          >
        </p>
        <div class="release-meta">
          <% if (release.year) { %><span><%= release.year %></span><% } %>
          <% if (release.price !== null) { %><span>$<%= release.price %></span
          ><% } %>
          <span
            ><%= release.stock %>
            in stock</span
          >
        </div>

       <div class="release-actions">
  <div class="action-group">
    <a href="/releases/<%= release.id %>/edit" class="button">Edit</a>
    <form
      action="/releases/<%= release.id %>/delete"
      method="POST"
      onsubmit="return confirm('Delete this release?');"
    >
      <button type="submit">Delete</button>
    </form>
  </div>
  <div class="action-group">
    <a href="/genres/<%= release.genre_id %>" class="button button--secondary"
      >Back to <%= release.genre_name %></a
    >
    <a href="/releases" class="button button--secondary">All releases</a>
  </div>
</div>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
