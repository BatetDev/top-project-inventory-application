<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New release</title>
    <link rel="stylesheet" href="/styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
  </head>
  <body>
    <h1>New release</h1>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <form method="POST" action="/releases">
      <label for="title">Title</label>
      <input type="text" name="title" id="title" value="<%= release.title %>" required />

      <label for="artist">Artist</label>
      <input type="text" name="artist" id="artist" value="<%= release.artist %>" required />

      <label for="genre_id">Genre</label>
      <select name="genre_id" id="genre_id" required>
        <option value="">Choose a genre</option>
        <% genres.forEach((genre) => { %>
          <option value="<%= genre.id %>" <%= Number(release.genre_id) === genre.id ? 'selected' : '' %>>
            <%= genre.name %>
          </option>
        <% }) %>
      </select>

      <label for="year">Year</label>
      <input type="number" name="year" id="year" value="<%= release.year %>" />

      <label for="price">Price</label>
      <input type="number" name="price" id="price" value="<%= release.price %>" min="0" step="0.01" />

      <label for="stock">Stock</label>
      <input type="number" name="stock" id="stock" value="<%= release.stock ?? 0 %>" min="0" required />

      <label for="cover_url">Cover URL</label>
      <input type="text" name="cover_url" id="cover_url" value="<%= release.cover_url %>" />

      <button type="submit">Create release</button>
      <a href="/releases">Cancel</a>
    </form>
  </body>
</html>