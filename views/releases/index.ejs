<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Releases — Old Ink Records</title>
    <link rel="stylesheet" href="/styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <%- include('../partials/header') %>
    <main>
      <h1>Releases</h1>
      <div class="page-actions">
        <a href="/releases/new" class="button button--invert">New release</a>
        <a href="/genres" class="button button--secondary">Browse genres</a>
      </div>
      <% if (releases.length === 0) { %>
      <p>No releases yet.</p>
      <% } else { %>
      <ul class="release-list">
        <% releases.forEach((release) => { %>
        <li class="release">
          <% if (release.cover_url) { %>
          <img
            class="release-cover"
            src="<%= release.cover_url %>"
            alt="Cover of <%= release.title %>"
            width="150"
            height="150"
            loading="lazy"
          />
          <% } else { %>
          <img
            class="release-cover"
            src="/images/no-cover.webp"
            alt="No cover available"
            width="150"
            height="150"
          />
          <% } %>
          <h2 class="release-title">
            <a class="card-link" href="/releases/<%= release.id %>"
              ><%= release.title %></a
            >
          </h2>
          <p class="release-artist"><%= release.artist %></p>
          <p class="release-genre">
            <a
              class="card-link-secondary"
              href="/genres/<%= release.genre_id %>"
              ><%= release.genre_name %></a
            >
          </p>
          <div class="release-meta">
            <% if (release.year) { %><span><%= release.year %></span><% } %>
            <% if (release.price !== null) { %><span>$<%= release.price %></span
            ><% } %>
            <span
              ><%= release.stock %>
              in stock</span
            >
          </div>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
