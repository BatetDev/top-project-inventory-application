<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Genres</title>
    <link rel="stylesheet" href="/styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <%- include('../partials/header') %>
    <main>
      <h1>Genres</h1>
      <div class="page-actions">
        <a href="/genres/new" class="button">New genre</a>
        <a href="/releases" class="button button--secondary">Browse releases</a>
      </div>
      <% if (genres.length === 0) { %>
      <p>No genres yet.</p>
      <% } else { %>
      <ul class="genre-list">
        <% genres.forEach((genre) => { %>
        <li class="genre">
          <h2 class="genre-name">
            <a class="card-link" href="/genres/<%= genre.id %>"
              ><%= genre.name %></a
            >
          </h2>
          <% if (genre.description) { %>
          <p class="genre-description"><%= genre.description %></p>
          <% } %>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
