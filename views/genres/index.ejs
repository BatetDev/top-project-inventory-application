<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head', { title: 'Genres — Old Ink Records' }) %>
  </head>
  <body>
    <%- include('../partials/header') %>
    <main>
      <div class="page-header">
        <h1>Genres</h1>
        <a href="/genres/new" class="button button--invert">New genre</a>
      </div>
      <% if (genres.length === 0) { %>
      <p>No genres yet.</p>
      <% } else { %>
      <ul class="genre-list">
        <% genres.forEach((genre) => { %>
        <li class="genre">
          <h2 class="genre-name">
            <a class="card-link" href="/genres/<%= genre.id %>"
              ><%= genre.name %></a
            >
          </h2>
          <% if (genre.description) { %>
          <p class="genre-description"><%= genre.description %></p>
          <% } %>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
