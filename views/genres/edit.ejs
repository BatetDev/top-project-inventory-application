<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head', { title: `Edit ${name} — Old Ink Records` }) %>
  </head>
  <body>
    <%- include('../partials/header') %>
    <main>
      <h1>Edit genre</h1>
      <% if (error) { %>
      <p class="error"><%= error %></p>
      <% } %>
      <form method="POST" action="/genres/<%= genre.id %>/edit">
        <label for="name">Name</label>
        <input type="text" name="name" id="name" value="<%= name %>" required />
        <label for="description">Description</label>
        <textarea name="description" id="description">
      <%= description %></textarea>
        <div class="form-actions">
          <a href="/genres/<%= genre.id %>" class="button button--secondary"
            >Cancel</a
          >
          <button type="submit" class="button--invert">Save changes</button>
        </div>
      </form>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
